{
  "name": "holistic-consulting-hq-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prisma-env.mjs generate && node scripts/prisma-env.mjs db push && next dev",
    "build": "node scripts/prisma-env.mjs generate && node scripts/prisma-env.mjs db push && tsx prisma/seed.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "node scripts/prisma-env.mjs db push",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:setup": "node scripts/prisma-env.mjs db push && tsx --env-file=.env prisma/seed.ts",
    "ingest": "tsx --env-file=.env scripts/ingest-youtube.ts",
    "postinstall": "node scripts/prisma-env.mjs generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
