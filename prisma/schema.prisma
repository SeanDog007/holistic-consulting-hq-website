generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

// Local default is SQLite. For Vercel, change provider to "postgresql"
// and point DATABASE_URL at Postgres. Speakers/programs/topics are JSON
// strings so the same schema works on both engines.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Video {
  id            String   @id @default(cuid())
  youtubeId     String   @unique
  title         String
  displayTitle  String?
  description   String   @default("")
  publishedAt   DateTime
  durationSec   Int      @default(0)
  thumbnailUrl  String   @default("")
  speakers      String   @default("[]")
  programs      String   @default("[]")
  topics        String   @default("[]")
  source        String   @default("youtube")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  segments      TranscriptSegment[]

  @@index([publishedAt])
}

model TranscriptSegment {
  id      String  @id @default(cuid())
  videoId String
  video   Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  startMs Int
  endMs   Int?
  text    String

  @@index([videoId])
}
