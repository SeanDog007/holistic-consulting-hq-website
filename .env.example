# Member gate for /library. If unset, the library is open (local/dev only).
LIBRARY_PASSWORD=institute

# SQLite for local. For Vercel, switch Prisma provider to postgresql
# and set a Postgres URL (Neon, Prisma Postgres, etc).
DATABASE_URL="file:./dev.db"

# Optional. Required for `npm run ingest` to pull @HolisticConsulting.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=HolisticConsulting
