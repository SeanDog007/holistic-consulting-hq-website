# Local default is SQLite (relative to prisma/).
# On Netlify, set this to a Postgres URL (Neon, Prisma Postgres, etc.).
DATABASE_URL="file:./dev.db"

# Optional. Required for `npm run ingest` to pull @HolisticConsulting.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=HolisticConsulting

# Optional Brain embeddings. Default is local MiniLM (no key, $0).
# auto | minilm | openai | tfidf
BRAIN_EMBED_PROVIDER=auto
# Only used when BRAIN_EMBED_PROVIDER=openai (or auto and this key is set).
# Needed at `npm run brain:embed` to bake vectors AND on Netlify to embed queries.
OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIM=512

# Optional. Brain Q&A uses a template summary when neither key is set.
# Prefer OpenAI when both are present. Synthesis still cites retrieved clips only.
# OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
