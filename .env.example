# Local default is SQLite (relative to prisma/).
# On Netlify, set this to a Postgres URL (Neon, Prisma Postgres, etc.).
DATABASE_URL="file:./dev.db"

# Optional. Required for `npm run ingest` to pull @HolisticConsulting.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=HolisticConsulting

# Optional. Brain Q&A uses a template summary when neither key is set.
# Prefer OpenAI when both are present. Synthesis still cites retrieved clips only.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
