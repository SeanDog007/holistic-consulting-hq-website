# Member gate for /library. Required on Netlify/production.
# Comma-separated values are all accepted (e.g. a strong live password
# plus the old demo password during a handoff).
LIBRARY_PASSWORD=institute

# Local default is SQLite (relative to prisma/).
# On Netlify, set this to a Postgres URL (Neon, Prisma Postgres, etc.).
DATABASE_URL="file:./dev.db"

# Optional. Required for `npm run ingest` to pull @HolisticConsulting.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=HolisticConsulting
